# ---- Telegram (optional but recommended) ----
# 1. Open Telegram, message @BotFather, send /newbot, follow prompts.
# 2. BotFather gives you a token like 8123456789:AAH...   -> paste after TELEGRAM_BOT_TOKEN=
# 3. Message your new bot once (say "hi"), then run:  python setup_telegram.py
#    That prints your chat id -> paste after TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- IsThereAnyDeal (optional) ----
# Gives real all-time-low prices across 40+ stores instead of only history
# this tracker has recorded itself. Free key: https://isthereanydeal.com/apps/new/
ITAD_API_KEY=

# ---- Claude chat (optional) ----
# Powers the Ask page. Key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
